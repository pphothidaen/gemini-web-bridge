{
  // Root wrangler config — exists for Cloudflare Workers Builds (the Git
  // integration), which builds from the repository root by default and
  // therefore found no config at all: both package.json and wrangler.toml
  // live in cloudflare-worker/. With nothing to build, every one of its
  // builds failed.
  //
  // It is a thin pointer at the real worker. cloudflare-worker/wrangler.toml
  // remains the source of truth and is what `npx wrangler deploy` uses when
  // run from that directory (as ci.yml/cd.yml do). Keep the two in sync —
  // name, entrypoint, DO binding, KV namespace and migrations must match.
  //
  // Must match cloudflare-worker/wrangler.toml — name, entrypoint, DO binding,
  // KV namespace and migrations.
  //
  // "prod" is the worker name, so the public hostname is
  // prod.gemini-web-bridge.workers.dev (the account subdomain is
  // "gemini-web-bridge"). Naming it "gemini-web-bridge" had produced the
  // doubled gemini-web-bridge.gemini-web-bridge.workers.dev.
  //
  // If you deploy from the repo root, this file is used instead. Do not
  // deploy from both places in the same pipeline.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prod",
  "main": "cloudflare-worker/src/index.js",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  // No [vars] here on purpose. BRIDGE_AUTH_TOKEN / CLIENT_API_TOKEN must be
  // set with `wrangler secret put`; a token in a committed config file is a
  // leaked token (see cloudflare-worker/wrangler.staging.toml, which used to
  // ship a guessable "staging-token-change-me").

  "durable_objects": {
    "bindings": [
      { "name": "BRIDGE_DO", "class_name": "GeminiBridgeDO" }
    ]
  },

  // Temporary PDF artifact storage for the horo_consult MCP tool (1h TTL).
  // Account-scoped id — must match cloudflare-worker/wrangler.toml. It belongs to
  // the Gemini.web.bridge@gmail.com Cloudflare account; the pre-migration id
  // (9620c1ac…) was in a different account and is not valid here.
  "kv_namespaces": [
    { "binding": "ARTIFACT_KV", "id": "400bc54565de455689ece92f8351bcb9" }
  ],

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GeminiBridgeDO"] }
  ],

  // Observability is OFF deliberately. Workers Logs captures and retains an
  // entry per invocation, charged against the same CPU budget that the DO
  // draws from; the September outage was "Exceeded allowed duration in
  // Durable Objects free tier". Nothing in this repo reads those logs:
  // `wrangler tail` gives the same events on demand, and the DO has no
  // metrics API on the free plan to scrape. Re-enable per-account if a paid
  // plan makes the retention worth its cost. See docs/TUNING.md.
  "observability": { "enabled": false }
}
