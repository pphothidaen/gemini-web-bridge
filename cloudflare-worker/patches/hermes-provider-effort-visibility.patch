diff --git a/tests/hermes_cli/test_inventory_reasoning_caps.py b/tests/hermes_cli/test_inventory_reasoning_caps.py
index a44878d2a6..b8c7ef370e 100644
--- a/tests/hermes_cli/test_inventory_reasoning_caps.py
+++ b/tests/hermes_cli/test_inventory_reasoning_caps.py
@@ -156,3 +156,35 @@ def test_catalog_failure_never_breaks_the_picker(monkeypatch):
     caps = rows[0]["capabilities"]["deepseek/deepseek-v4-pro"]
     assert "supported_efforts" not in caps
     assert caps["reasoning"] is True
+
+
+def test_configured_transport_hides_effort_for_all_models(tmp_path, monkeypatch):
+    # Real config loader and imports, isolated profile, no production credentials.
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    (tmp_path / "config.yaml").write_text("model:\n  provider: test-bridge\n  default: future-model\nproviders:\n  test-bridge:\n    capabilities:\n      reasoning: false\n")
+    ctx = inv.load_picker_context()
+    rows = [{"slug": "test-bridge", "models": ["future-model", "another-thinking-model"]},
+            {"slug": "custom:test-bridge", "models": ["future-model"]},
+            {"slug": "unconfigured-provider", "models": ["future-model"]}]
+    inv._apply_capabilities(rows, ctx.user_providers)
+    assert all(not c["reasoning"] for row in rows[:2] for c in row["capabilities"].values())
+    assert rows[2]["capabilities"]["future-model"]["reasoning"] is True
+
+
+def test_dashboard_reads_same_profile_transport_override(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    (tmp_path / "config.yaml").write_text("model:\n  provider: test-bridge\n  default: future-model\nproviders:\n  test-bridge:\n    capabilities:\n      reasoning: false\n")
+    from hermes_cli.web_routers.models import get_model_info
+    assert get_model_info()["capabilities"]["supports_reasoning"] is False
+
+
+def test_dynamic_endpoint_replaces_cached_catalog_on_every_probe(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    (tmp_path / "config.yaml").write_text("providers:\n  ephemeral:\n    base_url: https://example.test/v1\n    refresh_models_on_connect: true\n")
+    snapshots = iter([["old-model"], ["new-thinking-model"], []])
+    fetch = lambda: next(snapshots)
+    for expected in [["old-model"], ["new-thinking-model"], []]:
+        result = models_mod.cached_fetch_api_models("test-key", "https://example.test/v1", cache_only=True, fetch_models=fetch)
+        assert result == expected
+    entries = models_mod._load_provider_models_cache()
+    assert all(entry["models"] == [] for entry in entries.values())
