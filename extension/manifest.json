{
  "manifest_version": 3,
  "name": "Gemini Web-Bridge Extension",
  "version": "1.0.0",
  "description": "Bridge active authenticated Gemini web session to local terminal CLI",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "http://127.0.0.1:8787/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["https://gemini.google.com/*"]
    }
  ]
}
