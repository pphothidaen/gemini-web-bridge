# Gemini Web Bridge - Environment Variables Template
# Copy this file to .env and fill in real values
# DO NOT commit .env with real secrets — use GitHub Actions Secrets + Doppler

# Worker URL (deployment-specific, no secret)
WORKER_URL=https://gemini-web-bridge.pphothidaen.workers.dev

# API Tokens — DO NOT hardcode here, use Doppler or GitHub Secrets
# Copy this file to .env and fill in real values
# DO NOT commit .env with real secrets — use Doppler for local dev

# Doppler integration (local dev)
# DOPPLER_PROJECT=gemini-web-bridge
# DOPPLER_CONFIG=prd_worker
# DOPPLER_ENVIRONMENT=prd

# Cloudflare credentials (infra)
# CLOUDFLARE_ACCOUNT_ID=<from-github-secrets>
# CLOUDFLARE_API_TOKEN=<from-github-secrets>
# CF_TOKEN=<from-github-secrets>

# App secrets
# BRIDGE_AUTH_TOKEN=<from-github-secrets>
# CLIENT_API_TOKEN=<from-github-secrets>

# URLs (replace with production)
BRIDGE_BASE_URL=https://gemini-web-bridge.pphothidaen.workers.dev/v1
MCP_ENDPOINT=https://gemini-web-bridge.pphothidaen.workers.dev/mcp
WSS_BRIDGE_ENDPOINT=wss://gemini-web-bridge.pphothidaen.workers.dev/bridge
